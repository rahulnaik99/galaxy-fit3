<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="#102A43">

    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="KUBER  /  MONEY OVERVIEW" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="INVESTMENTS" android:textColor="#9FB3C8" android:textStyle="bold" android:textSize="10sp" />
    <TextView android:id="@+id/widget_investments" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Add holdings in Kuber Setup" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="3" android:ellipsize="end" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#36536D" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="SPENDING THIS MONTH" android:textColor="#9FB3C8" android:textStyle="bold" android:textSize="10sp" />
    <TextView android:id="@+id/widget_spends" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="₹ —" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Tap to open Kuber" android:textColor="#9FB3C8" android:textSize="10sp" />
</LinearLayout>
